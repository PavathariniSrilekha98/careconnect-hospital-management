{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Both (Backend + Frontend)",
      "dependsOn": ["Run Backend (Spring Boot)", "Run Frontend (Vite)"],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Run Backend (Spring Boot)",
      "type": "shell",
      "command": "cmd.exe",
      "args": ["/c", "mvnw.cmd spring-boot:run"],
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*Starting HospitalQueueApplication.*",
          "endsPattern": ".*Started HospitalQueueApplication.*"
        }
      },
      "presentation": {
        "panel": "new",
        "group": "servers",
        "reveal": "always"
      }
    },
    {
      "label": "Run Frontend (Vite)",
      "type": "shell",
      "command": "npm",
      "args": ["run", "dev"],
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*VITE.*",
          "endsPattern": ".*Local:.*http://localhost.*"
        }
      },
      "presentation": {
        "panel": "new",
        "group": "servers",
        "reveal": "always"
      }
    }
  ]
}
